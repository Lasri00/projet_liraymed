# =====================================================================
# LIRAY MED — Modèle de variables d'environnement
# Copier en .env et remplir. Le .env n'est JAMAIS committé.
# Les comptes sont ouverts au nom de Liray Med (section 5.2, option A).
# =====================================================================

# --- Base de données ---
DATABASE_URL=

# --- Stockage des fichiers et images ---
STORAGE_URL=
STORAGE_KEY=

# --- Envoi d'emails transactionnels ---
MAIL_API_KEY=
MAIL_FROM=
# Destinataire des notifications du formulaire de contact.
# Le cahier des charges indique liraymed00@gmail.com ;
# l'adresse réelle du Client est liraymedical@gmail.com. À confirmer.
MAIL_TO=

# --- Mise en relation ---
# ATTENTION : écart relevé entre le cahier des charges (66 44)
# et la signature du Client (66 00). À confirmer avant T6.
WHATSAPP_NUMBER=+2126768166

# --- Cartographie ---
MAPS_API_KEY=

# --- Mesure d'audience ---
ANALYTICS_ID=

# --- Application ---
SITE_URL=https://lirymed.com
ADMIN_PATH=
SESSION_SECRET=
